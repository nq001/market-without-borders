NODE_ENV=development
PORT=3000

# Local Windows PostgreSQL 16 + pgAdmin 4 connection string
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/commerce_dev

# Set REDIS_ENABLED=false to run without Docker Redis (uses in-memory TTL store)
# Set REDIS_ENABLED=true if running a native Windows Redis/Memurai service on 127.0.0.1:6379
REDIS_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379

JWT_ACCESS_SECRET=replace_with_strong_jwt_access_secret_min_16_chars
JWT_REFRESH_SECRET=replace_with_strong_jwt_refresh_secret_min_16_chars
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
PAYMENT_WEBHOOK_SECRET=replace_with_strong_webhook_hmac_secret
